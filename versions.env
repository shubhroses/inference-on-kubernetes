# The tool and image versions this repository pins, in one place.
#
# Every line is NAME=value with no quotes, no spaces and no references to
# other variables, so the same file can be sourced by a shell, included by
# make and appended to $GITHUB_ENV by a workflow. CI uses or checks every
# value here, so this list cannot drift from what actually runs.
#
# Images are written name:tag@digest. The digest decides what is pulled; the
# tag tells the reader which version that is. Each digest is that of the
# multi-platform index, so it is valid on amd64 and on arm64. To look one up:
#   docker buildx imagetools inspect docker.io/library/python:3.13.16-slim-trixie
# A name ending in _IMAGE or _CHART must end in a digest, or CI fails.
#
# Two kinds of pin live where they are used, because those files cannot read
# this one:
#   - Python packages, with hashes: requirements.txt and requirements-dev.txt
#   - GitHub Actions, by commit SHA: .github/workflows/

# The interpreter the unit tests run on in CI. CI also checks that the image
# contains this version, so the tests and the image use the same Python.
PYTHON_VERSION=3.13.16

# The base image. The Dockerfile has to spell it out in its first FROM line;
# CI fails if that line and this one differ.
PYTHON_IMAGE=docker.io/library/python:3.13.16-slim-trixie@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c

# The linters, the manifest validator and the vulnerability scanner, each run
# from its own image.
ACTIONLINT_IMAGE=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
HADOLINT_IMAGE=ghcr.io/hadolint/hadolint:v2.15.1@sha256:32dac94127fd60b7b7e3fbfc65e1383b9b5e25c9bfd7b8536de7a539fe68a12d
KUBECONFORM_IMAGE=ghcr.io/yannh/kubeconform:v0.8.0@sha256:faffaf43f95aa6425306e1ab8d6fcad72acb9049158f38e574c085ea1ec0f64e
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa

# kubeconform knows the kinds of object that are part of Kubernetes. For the
# others, such as the Prometheus Operator's ServiceMonitor, it reads the
# schemas in https://github.com/datreeio/CRDs-catalog, which are generated from
# each project's own definitions, as that repository was at this commit.
CRD_SCHEMAS_COMMIT=4c8dc296d32b06d15ccde9668ff136c951f4d539

# The Kubernetes release of the test cluster. kubectl is installed at this
# version, and kubeconform checks the chart against this version's API schemas.
# 1.36 and not the newer 1.37, because 1.36 is the newest release that KEDA
# 2.21, the autoscaler this project is being built towards, is tested against.
KUBERNETES_VERSION=1.36.4

# kind, and the node image for the Kubernetes release above. A node image is
# built for one kind release: this is the 1.36 image listed in the release
# notes of kind 0.33.0, so the two lines change together. CI fails if the
# image's tag is not KUBERNETES_VERSION.
KIND_VERSION=0.33.0
KIND_NODE_IMAGE=docker.io/kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

HELM_VERSION=4.3.0

# The SHA-256 of each tool's linux/amd64 download, as its project publishes it:
#   https://github.com/kubernetes-sigs/kind/releases/download/v0.33.0/kind-linux-amd64.sha256sum
#   https://dl.k8s.io/release/v1.36.4/bin/linux/amd64/kubectl.sha256
#   https://get.helm.sh/helm-v4.3.0-linux-amd64.tar.gz.sha256sum
# CI installs the three tools with scripts/install-tools.sh, which refuses a
# download that does not match.
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KUBECTL_SHA256=8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a
HELM_SHA256=86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb

# Prometheus and Grafana for the test cluster: the kube-prometheus-stack chart.
# It is written the way the images are, name:version@digest, and Helm refuses
# to install it if the registry's copy of that version has another digest. To
# look one up:
#   helm pull oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack --version 91.9.0
# This version runs Prometheus Operator 0.94.1, Prometheus 3.15.0, Grafana
# 13.2.3 and kube-state-metrics 2.20.0. The chart names their images by tag, so
# the digest here pins the chart and, through it, those tags.
# 91.9.0 and not 92.x: that line was two days old when this was written, and it
# brings the same versions of these four.
KUBE_PROMETHEUS_STACK_CHART=oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack:91.9.0@sha256:04047e500c803dc8d2bc284ecb43e9229bb32b5c36bd13fc89592c8a2f3cdc72

# promtool, which checks and unit-tests the chart's alert rules in CI. It comes
# from the image of the Prometheus that the chart above runs in the test
# cluster, so the rules are checked by the release that will evaluate them.
# The end-to-end tests fail if the cluster's Prometheus is another release.
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0-distroless@sha256:b2a413d5a03ea6a76782a508d1c7947440bba3b973931a25676e278431891b01
